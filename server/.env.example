NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/kanan-baroda
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Comma-separated if you run the client on more than one origin/port.
# In development, any http://localhost:<port> is allowed regardless of this
# value (see server/src/app.ts) — Vite's port drifts if 5173 is taken.
CLIENT_URL=http://localhost:5173
UPLOAD_STORAGE=local
