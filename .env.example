# Root reference for every environment variable the system uses
# (ARCH-SPEC DIR·08). In practice each app reads its own copy —
# see server/.env.example and client/.env.example — this file is the
# documented master list.

# --- Server ---
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/kanan-baroda
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Comma-separated. In development any http://localhost:<port> is also
# allowed automatically (see server/src/app.ts).
CLIENT_URL=http://localhost:5173
UPLOAD_STORAGE=local
# Required only if UPLOAD_STORAGE=cloudinary
CLOUDINARY_URL=
# Required only if UPLOAD_STORAGE=s3
AWS_BUCKET=
AWS_REGION=

# --- Client ---
VITE_API_URL=http://localhost:4000/api
